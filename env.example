# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# CLI Configuration
NODE_ENV=development

# Optional: model and endpoint
# OPENAI_MODEL=gpt-6-luna            # or gpt-6.1-terra, deepseek-flash, gemini-3.5-flash-lite
# OPENAI_BASE_URL=                   # any OpenAI-compatible endpoint (OpenRouter...)
# OPENAI_REASONING_EFFORT=none
# DEEPSEEK_API_KEY=                  # used by deepseek-* models
# GEMINI_API_KEY=                    # used by gemini-* models
